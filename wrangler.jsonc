// Every page is prerendered and served as a static asset; the Worker answers only what no page matches.
// Production is `earshot` on seo.mia.cx, the canonical address, and earshot.mia.cx, which serves the
// same pages without redirecting; their canonical URLs point to seo.mia.cx. It deploys when a release
// pull request merges. Staging is `earshot-staging` on staging.seo.mia.cx, deployed from every push to
// main (.github/workflows/release.yml).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "earshot",
	"account_id": "492214885e7a580ccc1d141dfdb4dc5f",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"routes": [
		{ "pattern": "seo.mia.cx", "custom_domain": true },
		{ "pattern": "earshot.mia.cx", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// Lesson narration, served at /narration/… (scripts/narrate.ts writes it). Remote, so `pnpm dev`
	// plays the real bucket too; every environment shares it, since audio is stored under a hash of
	// the text it reads.
	"r2_buckets": [{ "binding": "NARRATION", "bucket_name": "earshot-narration", "remote": true }],
	"env": {
		"staging": {
			"routes": [{ "pattern": "staging.seo.mia.cx", "custom_domain": true }],
			// Bindings don't carry over into an environment.
			"r2_buckets": [{ "binding": "NARRATION", "bucket_name": "earshot-narration", "remote": true }]
		}
	}
}
