# Files written for agents stay out of search results, so searches land on the pages instead:
# llms.txt, each page's Markdown copy, and the agent skills. Staging replaces this file with one
# that says noindex for everything (.github/workflows/deploy.yml).
/llms.txt
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
/.well-known/agent-skills/*
  X-Robots-Tag: noindex
